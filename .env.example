# Upstash Redis（Vercel / 自建部署必填，仅服务端使用，切勿暴露给前端；
# Cloudflare Pages 使用 KV 绑定时不需要本节）
# 两种凭据名二选一：
#   方式一（推荐）：Vercel Marketplace 安装 Upstash for Redis 后自动注入——
#     KV_REST_API_URL=https://xxx.upstash.io
#     KV_REST_API_TOKEN=xxxx
#   方式二：Upstash Console 手动建库后填写——
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# 登录密码（必填：未配置时除 health/status/login/logout 外全部 503，登录页显示未配置提示）
AUTH_PASSWORD=your-password
# 可选：HMAC 签名密钥（不设置则由 AUTH_PASSWORD 派生）
# AUTH_SECRET=your-random-secret

# 可选：本地演示模式（不连接数据库，使用进程内存数据，重启后恢复示例数据）
# STORE=memory
